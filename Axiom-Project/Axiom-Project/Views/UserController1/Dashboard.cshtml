@model Axiom_Project.Models.User

@{
    ViewData["Title"] = "Dashboard";
}

<style>
    .dashboard-container {
        min-height: 70vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #eef2ff, #f8fafc);
        padding: 2rem 0;
    }

    .profile-card {
        border-radius: 18px;
        box-shadow: 0 20px 40px rgba(0,0,0,0.08);
        border: 1px solid #e5e7eb;
        background: #ffffffcc;
        backdrop-filter: blur(6px);
        transition: transform .3s ease, box-shadow .3s ease;
    }

        .profile-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 28px 55px rgba(0,0,0,0.12);
        }

    .detail-term {
        font-weight: 700;
        color: #1f2937;
    }

    h1 {
        font-weight: 700;
        background: linear-gradient(90deg, #1e3a8a, #3b82f6);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    hr {
        border-top: 1px solid #d1d5db;
    }

    .logout-btn {
        border-radius: 10px;
        font-weight: 600;
        letter-spacing: .5px;
    }

        .logout-btn:hover {
            box-shadow: 0 10px 25px rgba(239, 68, 68, .25);
        }
</style>

<div class="container dashboard-container">
    <div class="card profile-card w-100" style="max-width:720px;">
        <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-start mb-3">
                <h1 class="h5 mb-0">Hello, @Model.name 👋</h1>
                <a asp-action="Logout" class="btn btn-danger logout-btn">Logout</a>
            </div>

            <h4 class="h6 text-muted">Your Profile Details</h4>
            <hr />

            <dl class="row mb-0">
                <dt class="col-sm-3 detail-term">Name</dt>
                <dd class="col-sm-9">@Model.name</dd>

                <dt class="col-sm-3 detail-term">Email</dt>
                <dd class="col-sm-9">@Model.email</dd>

                <dt class="col-sm-3 detail-term">Password</dt>
                <dd class="col-sm-9">@Model.password</dd>
            </dl>

        </div>
    </div>
</div>
