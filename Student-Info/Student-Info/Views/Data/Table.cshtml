@model List<Student_Info.Models.Info>

@{
    ViewData["Title"] = "Table";
}

<h1>All Students</h1>
<hr />

<table class="table table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Roll No</th>
            <th>Name</th>
            <th>Course</th>
            <th>Gender</th>
            <th>Address</th>
            <th>Phone</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var student in Model)
        {
            <tr>
                <td>@student.Roll</td>
                <td>@student.Name</td>
                <td>@student.Course</td>
                <td>@student.gender</td>
                <td>@student.Address</td>
                <td>@student.phone</td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Index" class="btn btn-primary">Back to Form</a>
