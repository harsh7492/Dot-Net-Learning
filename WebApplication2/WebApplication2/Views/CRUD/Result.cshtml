@{
}
@model List<WebApplication2.Models.People>
<h1>Record</h1>
<table class="table table-bordered table-hover table-striped text-center">
    <thead>
        <tr>
     <th>ID</th>
    <th>Name</th>
    <th>Age</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.Age</td>
            </tr>
        }
    </tbody>
</table>